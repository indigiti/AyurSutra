{
  "name": "ayursutra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "dev:api": "php -S 127.0.0.1:8000 -t server/public server/public/router.php",
    "check": "tsc --noEmit",
